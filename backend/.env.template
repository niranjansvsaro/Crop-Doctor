# Crop Doctor Backend Environment Configuration
# Duplicate this file as .env and fill in the values below.

# NVIDIA NIM API Key (microsoft/phi-3-vision-128k-instruct)
# Get one from: https://build.nvidia.com/microsoft/phi-3-vision-128k-instruct
NVIDIA_API_KEY=your_nvidia_api_key_here

# Supabase Configurations
# Get these from your Supabase Project Settings -> API
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_anon_or_service_key_here
